%global package_version @BLUEBRIDGE_VERSION_MAJOR@.@BLUEBRIDGE_VERSION_MINOR@.@BLUEBRIDGE_VERSION_PATCH@
%global tarname BlueBridge-%{version}-Source
%global bluebridge_version_desc @BLUEBRIDGE_VERSION_DESC@
%global timestamp @BLUEBRIDGE_BUILD_DATE@@BLUEBRIDGE_BUILD_TIME@

%global rdnn_name io.github.bigoreo.bluebridge

Summary: Keyboard and mouse sharing solution
Name: bluebridge
Version: %{package_version}
Release: %{timestamp}.git%{?dist}
# FIXME: Does not work with RPMs, address later.
# FIXME: %%{bluebridge_version_desc}%%{?dist}
License: GPLv2
Group: System Environment/Daemons
URL: https://github.com/BigOreo/BlueBridge
# Run cmake package_source to get this tarball
Source0: %{tarname}.tar.xz

BuildRequires: pkgconfig(avahi-compat-libdns_sd)
BuildRequires: cmake >= 3
BuildRequires: desktop-file-utils
BuildRequires: gcc-c++
BuildRequires: pkgconfig(gmock)
BuildRequires: pkgconfig(gtest)
BuildRequires: pkgconfig(x11)
BuildRequires: pkgconfig(xtst) pkgconfig(xinerama) pkgconfig(xrandr)
BuildRequires: pkgconfig(ice) pkgconfig(sm)
BuildRequires: pkgconfig(openssl)
BuildRequires: pkgconfig(Qt6Core)
BuildRequires: pkgconfig(Qt6Widgets)
BuildRequires: pkgconfig(Qt6Network)
BuildRequires: pkgconfig(Qt6Linguist)
BuildRequires: make
BuildRequires: pkgconfig(libei-1.0)
BuildRequires: pkgconfig(libportal) >= 0.8

%description
BlueBridge allows you to share one mouse and keyboard between multiple computers.
Work seamlessly across Windows, macOS and Linux.

%prep
%setup -q -n %{tarname}


%build
%{cmake} . \
    -DBLUEBRIDGE_VERSION_DESC:STRING=%{bluebridge_version_desc} \
    -DBLUEBRIDGE_BUILD_LIBEI=ON \
    -DBLUEBRIDGE_BUILD_TESTS=ON \
    -DBLUEBRIDGE_USE_EXTERNAL_GTEST=True \
    -DBLUEBRIDGE_VERSION_STAGE:STRING=@BLUEBRIDGE_VERSION_STAGE@
%{cmake_build}


%install
%{cmake_install}

desktop-file-install --delete-original \
  --dir %{buildroot}%{_datadir}/applications \
  --set-icon=%{_datadir}/icons/hicolor/scalable/apps/%{rdnn_name}.svg \
  %{buildroot}%{_datadir}/applications/%{rdnn_name}.desktop

%check
%ctest
desktop-file-validate %{buildroot}/%{_datadir}/applications/%{rdnn_name}.desktop

%files
# None of the documentation files are actually useful here, they all point to
# the online website, so include just one, the README
%doc LICENSE ChangeLog res/Readme.txt doc/%{name}.conf.example*
%{_bindir}/%{name}-client
%{_bindir}/%{name}-server
%{_bindir}/%{name}
%{_datadir}/icons/hicolor/scalable/apps/%{rdnn_name}.svg
%{_datadir}/applications/%{rdnn_name}.desktop
%{_datadir}/metainfo/%{rdnn_name}.appdata.xml
%{_mandir}/man1/%{name}-client.1*
%{_mandir}/man1/%{name}-server.1*

%changelog
* Wed Oct 07 2026 BlueBridge <BigOreo@users.noreply.github.com>
- First BlueBridge package
