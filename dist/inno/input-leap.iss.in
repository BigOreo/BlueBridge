#define MyAppName "BlueBridge"
#define MyAppVersion "@INPUTLEAP_VERSION_MAJOR@.@INPUTLEAP_VERSION_MINOR@.@INPUTLEAP_VERSION_PATCH@"
#define MyAppTextVersion "@INPUTLEAP_VERSION@"
#define MyAppPublisher "BlueBridge"
#define MyAppURL "https://github.com/BigOreo/BlueBridge"
#define MyAppCopyright "Copyright (C) BlueBridge and InputLeap contributors"
#define MyAppExeName "input-leap.exe"
; the service keeps its original internal name so upgrades replace it
#define MyAppServiceName "InputLeap"
#define MyAppServiceExe "input-leapd.exe"
#define MyAppServerExe "input-leaps.exe"
#define MyAppClientExe "input-leapc.exe"
#define MyAppServiceDesc "Manages the BlueBridge background processes."
#define MyAppListenerDesc "BlueBridge Listener"
#define OldListenerDesc "InputLeap Listener"

[Setup]
AppId={{41036EA6-3F7A-4803-8AE0-46912391EFCC}
AppName={#MyAppName}
AppVersion={#MyAppTextVersion}
AppVerName={#MyAppName} {#MyAppTextVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={pf}\{#MyAppName}
DisableProgramGroupPage=yes
LicenseFile=@CMAKE_CURRENT_SOURCE_DIR@/res/License.rtf
OutputDir=@CMAKE_INSTALL_PREFIX@/../installer-inno/bin
OutputBaseFilename=BlueBridgeSetup-{#MyAppTextVersion}
SetupIconFile=@CMAKE_CURRENT_SOURCE_DIR@/res/input-leap.ico
WizardStyle=modern
DisableWelcomePage=no
WizardImageFile=@CMAKE_CURRENT_SOURCE_DIR@/res/inno/wizard-large-100.bmp,@CMAKE_CURRENT_SOURCE_DIR@/res/inno/wizard-large-150.bmp,@CMAKE_CURRENT_SOURCE_DIR@/res/inno/wizard-large-200.bmp
WizardSmallImageFile=@CMAKE_CURRENT_SOURCE_DIR@/res/inno/wizard-small-100.bmp,@CMAKE_CURRENT_SOURCE_DIR@/res/inno/wizard-small-150.bmp,@CMAKE_CURRENT_SOURCE_DIR@/res/inno/wizard-small-200.bmp
VersionInfoProductTextVersion={#MyAppTextVersion}
VersionInfoProductVersion={#MyAppVersion}
VersionInfoTextVersion={#MyAppTextVersion}
VersionInfoVersion={#MyAppVersion}
VersionInfoCopyright={#MyAppCopyright}

Compression=lzma
SolidCompression=yes
ArchitecturesInstallIn64BitMode=x64
UninstallDisplayIcon={app}\{#MyAppExeName}

#include "scripts\lang\english.iss"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "@CMAKE_INSTALL_PREFIX@/*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[InstallDelete]
; shortcuts left by versions released under the InputLeap name
Type: files; Name: "{commonprograms}\InputLeap.lnk"
Type: files; Name: "{commondesktop}\InputLeap.lnk"

[Icons]
Name: "{commonprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{commondesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: {sys}\netsh.exe; Parameters: "advfirewall firewall delete rule name=""{#OldListenerDesc}"""; Flags: runhidden
; there's no "check if exists" or "insert if not exists" for netsh's firewall commands
; to avoid duplicate entries remove the existing rule (fails if it doesn't exist) before adding
Filename: {sys}\netsh.exe; Parameters: "advfirewall firewall delete rule name=""{#MyAppListenerDesc}"""; Flags: runhidden
Filename: {sys}\netsh.exe; Parameters: "advfirewall firewall add rule name=""{#MyAppListenerDesc}"" protocol=TCP dir=in localport=24800 action=allow"; StatusMsg: "Letting your other computers reach this one on your network..."; Flags: runhidden
Filename: {sys}\sc.exe; Parameters: "create {#MyAppServiceName} start= auto binPath= ""\""{app}\{#MyAppServiceExe}\"""""; Flags: runhidden
Filename: {sys}\sc.exe; Parameters: "config {#MyAppServiceName} displayname= ""{#MyAppName}"""; Flags: runhidden
Filename: {sys}\sc.exe; Parameters: "description {#MyAppServiceName} ""{#MyAppServiceDesc}"""; Flags: runhidden
Filename: {sys}\sc.exe; Parameters: "start {#MyAppServiceName}"; StatusMsg: "Starting the background helper..."; Flags: runhidden
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

[UninstallDelete]
Type: filesandordirs; Name: "{commonappdata}\InputLeap"

[UninstallRun]
Filename: {sys}\taskkill; Parameters: "/im {#MyAppExeName} /f /t"; Flags: runhidden
Filename: {sys}\net.exe; Parameters: "stop {#MyAppServiceName}"; Flags: runhidden
; the service leaves the server/client process it started running
Filename: {sys}\taskkill; Parameters: "/im {#MyAppServerExe} /im {#MyAppClientExe} /f"; Flags: runhidden
Filename: {sys}\sc.exe; Parameters: "delete {#MyAppServiceName}"; Flags: runhidden
Filename: {sys}\netsh.exe; Parameters: "advfirewall firewall delete rule name=""{#MyAppListenerDesc}"""; Flags: runhidden
Filename: {sys}\netsh.exe; Parameters: "advfirewall firewall delete rule name=""{#OldListenerDesc}"""; Flags: runhidden

[Messages]
WelcomeLabel1=Set up [name]
WelcomeLabel2=Use one keyboard and mouse across your computers, over your network or straight over Bluetooth.%n%nTakes about a minute. No restart needed.
FinishedHeadingLabel=This computer is ready
FinishedLabel=When [name] opens, choose whose keyboard and mouse this computer will use. Then install it on your other computer too.
FinishedLabelNoIcons=When [name] opens, choose whose keyboard and mouse this computer will use. Then install it on your other computer too.

[CustomMessages]
DependenciesDir="redist"

; shared code for installing the products
#include "scripts\products.iss"
#include "scripts\products\stringversion.iss"
#include "scripts\products\winversion.iss"
#include "scripts\products\msiproduct.iss"
#include "scripts\products\vcredist2017.iss"

[Code]
function InitializeSetup(): boolean;
begin
	// initialize windows version
	initwinversion();

	vcredist2017('14'); // min allowed version is 14.0

	Result := true;
end;

// Restart Manager can't close the service or the server/client processes it
// starts, so stop them before files are replaced on an upgrade or reinstall.
<event('PrepareToInstall')>
function StopInputLeap(var NeedsRestart: Boolean): String;
var
	ResultCode: Integer;
begin
	Exec(ExpandConstant('{sys}\net.exe'), 'stop {#MyAppServiceName}', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
	Exec(ExpandConstant('{sys}\taskkill.exe'), '/f /t /im {#MyAppExeName} /im {#MyAppServerExe} /im {#MyAppClientExe} /im {#MyAppServiceExe}', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
	Result := '';
end;
