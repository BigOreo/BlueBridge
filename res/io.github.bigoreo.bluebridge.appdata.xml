<component type="desktop-application">
  <id>io.github.bigoreo.bluebridge</id>
  <metadata_license>FSFAP</metadata_license>
  <project_license>GPL-2.0</project_license>
  <name>BlueBridge</name>
  <summary>Share mouse and keyboard between multiple computers over the network</summary>
  <developer id="io.github.bluebridge">
    <name>BlueBridge Team</name>
  </developer>
  <content_rating type="oars-1.1" />

  <description>
    <p>
      BlueBridge allows you to share one mouse and keyboard between multiple computers.
      Work seamlessly across Windows, macOS and Linux.
    </p>
  </description>

  <launchable type="desktop-id">io.github.bigoreo.bluebridge.desktop</launchable>

  <url type="homepage">https://github.com/BigOreo/BlueBridge</url>
  <url type="bugtracker">https://github.com/BigOreo/BlueBridge/issues</url>

  <screenshots>
    <screenshot type="default">
      <caption>Pairing and connections screen</caption>
      <image>https://github.com/user-attachments/assets/15274a63-94e9-4ef2-a66c-ff85bffddd73</image>
    </screenshot>
    <screenshot>
      <caption>Settings screen</caption>
      <image>https://github.com/user-attachments/assets/cb7391f7-401e-488c-8661-ac6acaca6432</image>
    </screenshot>
  </screenshots>

  <categories>
    <category>Network</category>
  </categories>

  <keywords>
    <keyword translate="no">KVM</keyword>
    <keyword translate="no">Input</keyword>
    <keyword translate="no">Leap</keyword>
  </keywords>

  <!-- TODO Review branding colors -->
  <branding>
    <color type="primary" scheme_preference="light">#deddda</color>
    <color type="primary" scheme_preference="dark">#5e5c64</color>
  </branding>

  <provides>
    <id>io.github.bigoreo.bluebridge.desktop</id>
    <binary>bluebridge</binary>
    <binary>bluebridge-client</binary>
    <binary>bluebridge-server</binary>
  </provides>


  <releases>
    <release version="1.0.0" date="2026-10-07"/>
  </releases>
</component>

